# Root Project Environment Variables Template
# Copy this file to .env when running docker-compose or local setup

# MySQL Configuration for Docker Compose or local server
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=appointment_queue_db
MYSQL_USER=savemom_user
MYSQL_PASSWORD=your_user_password_here
MYSQL_PORT=3306

# Backend Configuration
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_queue_db
DB_USERNAME=root
DB_PASSWORD=your_root_password_here
JWT_SECRET=your_custom_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000


# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
