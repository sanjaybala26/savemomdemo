# Backend Environment Variables Template
# Copy this file to .env or set these in your local environment / shell

# Server port
SERVER_PORT=8080

# MySQL Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_queue_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Full database URL (optional override)
# DB_URL=jdbc:mysql://localhost:3306/appointment_queue_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Flyway migration flag (true to enable migrations)
FLYWAY_ENABLED=true

# JWT Authentication
JWT_SECRET=your_custom_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000

